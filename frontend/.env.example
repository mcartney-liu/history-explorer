# History Explorer — frontend environment (Vite)
# Copy to `.env` / `.env.local` and adjust as needed.
# All values are OPTIONAL; unset vars fall back to the defaults below.

# Base URL of the History Explorer backend API.
# Standard single-stack dev backend runs on 8000.
# If running the dual-stack comparison setup (admin on 8001), set this to:
#   VITE_API_BASE=http://localhost:8001
VITE_API_BASE=http://localhost:8000

# M74-003 (C3-2): AI Exploration Suggestions touchpoints.
# Default OFF — M73 behaviour stays byte-identical. Set to true to enable the
# evidence-bound exploration suggestions on Package / Entity pages.
VITE_AI_SUGGESTIONS_ENABLED=false
